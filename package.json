{
  "name": "lumi-joy",
  "version": "0.1.0",
  "description": "Greenfield 3-tier monolithic agent framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lumi": "dist/index.js",
    "lumi-joy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "PATENT-NON-AGGRESSION-PLEDGE.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx scripts/validate-dsl-strategy.ts && node --import tsx scripts/validate-context-management.ts && node --import tsx scripts/validate-runtime-baseline.ts && node --import tsx scripts/validate-documentation.ts && node --import tsx scripts/validate-repo.ts",
    "smoke": "node --import tsx src/index.ts --smoke",
    "benchmark": "node --import tsx src/index.ts --benchmark",
    "baseline:update": "node --import tsx src/index.ts --baseline",
    "guardrail": "node --import tsx scripts/validate-repo.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.147.0",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.5",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12"
  }
}
