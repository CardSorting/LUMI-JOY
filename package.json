{
  "name": "lumi-new",
  "version": "0.1.0",
  "description": "Greenfield 3-tier monolithic agent framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lumi": "dist/index.js",
